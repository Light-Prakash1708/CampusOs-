# ---------------------------------------------------------------------------
# CampusOS — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# Validated at boot by src/lib/env.ts: in production an invalid configuration
# stops the server with a list of what to fix.
#
# Production REQUIRES: DATABASE_URL, AUTH_SECRET, CRON_SECRET, APP_URL (on
# Render, APP_URL may be left unset; RENDER_EXTERNAL_URL is used). Everything
# else is optional; set a provider to "none" to keep it off.
# On Render these are declared in render.yaml. See DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL 15+) — REQUIRED ------------------------------------
# On Render, this is wired from the Blueprint's database automatically.
DATABASE_URL="postgresql://postgres:campusos@localhost:5432/campusos"
# Supabase (use the SESSION pooler, port 5432, for migrations and the app):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# TLS: disable | require | verify   (default: disable for localhost, require otherwise)
# DATABASE_SSL="require"
# Only with DATABASE_SSL="verify", when the provider's CA isn't in the system store (PEM):
# DATABASE_CA_CERT=""
# DB_POOL_MAX="10"

# --- Application -----------------------------------------------------------
APP_URL="http://localhost:3000"      # absolute; used in emailed links (optional on Render)
NODE_ENV="development"
# Honour x-forwarded-for from the platform proxy (Render/Vercel/nginx). Set
# "false" only when Node is exposed directly to the internet.
TRUST_PROXY="true"
# Proxies in front of the app that append to x-forwarded-for (1 = Render alone;
# 2 = Cloudflare in front of Render). The client IP is read from the right.
TRUSTED_PROXY_HOPS="1"
# Timezone for displaying dates/times (server and browser agree). Colleges
# keep their own timezone for schedules; this is the display default.
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"

# --- Auth ------------------------------------------------------------------
# openssl rand -base64 48
AUTH_SECRET="replace-with-openssl-rand-base64-48-output-000000000000"
SESSION_MAX_AGE="28800"
BCRYPT_COST="12"

# --- Student sign-up (OPTIONAL) ----------------------------------------------
# "true" lets anyone create a STUDENT account without a college; each gets a
# private workspace. Colleges' own onboarding (invitations, registration
# policies) works either way. Default: off.
SELF_REGISTRATION_ENABLED="true"

# --- Demo mode (development only; refused in production) --------------------
DEMO_MODE="true"
DEMO_PASSWORD="CampusOS!Demo2026"

# --- Scheduled jobs --------------------------------------------------------
# openssl rand -base64 32 — required in production
CRON_SECRET=""

# --- AI --------------------------------------------------------------------
AI_PROVIDER="local"                 # local | anthropic
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-6"
AI_MAX_TOKENS="4096"
AI_MONTHLY_BUDGET_USD="50"          # per institution
AI_USER_HOURLY_LIMIT="30"           # per person

# --- File storage ----------------------------------------------------------
# local | s3 | supabase | none
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./.storage"
STORAGE_MAX_FILE_MB="20"
# S3-compatible (AWS S3, Cloudflare R2, MinIO) or Supabase Storage (S3 endpoint):
# STORAGE_ENDPOINT="https://<ref>.supabase.co/storage/v1/s3"
# STORAGE_REGION="ap-south-1"
# STORAGE_BUCKET="campusos"
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# Single persistent server only:
# ALLOW_LOCAL_STORAGE="true"
MALWARE_SCANNER="none"              # none | signature (basic built-in checks)

# --- Notifications ---------------------------------------------------------
EMAIL_PROVIDER="console"            # console (dev) | resend | none
EMAIL_FROM="CampusOS <no-reply@campusos.local>"
RESEND_API_KEY=""
PUSH_PROVIDER="none"                # none | console | fcm
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
SMS_PROVIDER="none"                 # none | console | msg91
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""                # DLT-registered template
WHATSAPP_PROVIDER="none"            # none | console

# --- Observability ---------------------------------------------------------
LOG_LEVEL="info"
# Forward unhandled errors (scrubbed: error, route, request id, release) to a
# JSON collector. none | webhook
ERROR_REPORTER="none"
# ERROR_WEBHOOK_URL="https://collector.example.com/campusos"

# ── Career Mode: opportunities feed (optional) ───────────────────────────────
# Imports internships/jobs from a JSON feed your placement cell subscribes to.
# Imported items wait for an administrator to approve them. See docs/CAREER.md.
OPPORTUNITY_FEED_PROVIDER="none"          # none | json-feed
# OPPORTUNITY_FEED_URL="https://placements.example.edu/campusos-feed.json"
# OPPORTUNITY_FEED_TOKEN=""               # sent as "Authorization: Bearer …" if set
# SENTRY_DSN=""

# --- Deployment (GitHub Actions secrets, not app env) ---------------------
# RENDER_DEPLOY_HOOK_URL, APP_URL — see docs/DEPLOYMENT.md
# --- Payments (planned; not used yet) ---------------------------------------
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
