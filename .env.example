# ---------------------------------------------------------------------------
# CampusOS — Environment Configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Local dev example:
DATABASE_URL="postgresql://postgres:campusos@localhost:5432/campusos?schema=public"
# Supabase example:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Application -----------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Auth ------------------------------------------------------------------
# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me-in-production-please-0000"
# Session lifetime in seconds (default 8h)
SESSION_MAX_AGE="28800"

# --- Demo mode -------------------------------------------------------------
# When "true" AND NODE_ENV !== production, enables the role switcher and
# seeded demo credentials on the login screen. MUST be false in production.
DEMO_MODE="true"
# Password applied to all seeded demo accounts (development only).
DEMO_PASSWORD="CampusOS!Demo2026"

# --- AI --------------------------------------------------------------------
# Provider: "anthropic" | "local"
# "local" runs a deterministic, offline reasoning provider so the whole
# product works with zero API keys. Clearly labelled in the UI.
AI_PROVIDER="local"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-6"
AI_MAX_TOKENS="4096"
# Hard ceiling on estimated AI spend per institution per month (USD).
AI_MONTHLY_BUDGET_USD="50"

# --- Storage (file attachments) --------------------------------------------
# Provider: "local" | "s3" | "supabase"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./.storage"
STORAGE_BUCKET=""
STORAGE_MAX_FILE_MB="25"

# --- Notification channels (interfaces defined; adapters pluggable) --------
EMAIL_PROVIDER="none"        # none | smtp | resend | ses
PUSH_NOTIFICATION_PROVIDER="none"  # none | webpush | fcm
SMS_PROVIDER="none"          # none | twilio | msg91
CRON_SECRET=""
